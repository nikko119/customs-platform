DATABASE_URL=
# 跨电脑读取改写稿使用 EXPORT_API_KEY；管理接口使用不同的 ADMIN_API_KEY。
# 仅在本机 127.0.0.1 使用管理台时可以留空；对外开放前必须设置随机密钥。
EXPORT_API_KEY=
ADMIN_API_KEY=
# MySQL 5.7 示例：mysql+pymysql://用户名:密码@127.0.0.1:3306/customs_platform?charset=utf8mb4
# 这是你提供的 OpenAI 兼容中转站地址；运行后端的电脑需要能访问该局域网地址。
LLM_BASE_URL=http://192.168.0.42:8080/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
CBP_KEYWORDS=seize,seized,seizure,intercept,customs,tariff,package,parcel,shipping,smuggling,counterfeit,import,cargo,duty,courier
CBP_RECENT_DAYS=30
CBP_INTERVAL=1.5
CBP_OUTPUT_DIR=data
CBP_LOG_FILE=data/cbp.log
LOG_LEVEL=INFO
CBP_SLOW_MO=0
